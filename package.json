{
  "name": "osgatos",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "format": "prettier --write \"**/*.ts*\" --config ./.prettierrc.json",
    "magic": "bun run lint:fix && bun run format && bun run check-types",
    "download-transcripts": "bun --conditions react-server ./scripts/download-transcripts.ts",
    "sync-transcripts": "bun --conditions react-server ./scripts/sync-transcripts.ts"
  },
  "dependencies": {
    "@heroui/theme": "2.4.24",
    "@next/third-parties": "16.3.4",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.541.0",
    "next": "16.3.4",
    "pocketbase": "^0.26.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "swr": "^2.3.6"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.4",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "20.5.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "postcss": "8.5.6",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "4.1.11",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.18.0"
  }
}
